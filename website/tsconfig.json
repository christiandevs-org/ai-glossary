// This file is not used by "docusaurus start/build" commands.
// It is here to improve your IDE experience (type-checking, autocompletion...),
// and can also run the package.json "typecheck" script manually.
{
  "extends": "@docusaurus/tsconfig",
  "compilerOptions": {
    "baseUrl": ".",
    "ignoreDeprecations": "6.0",
    "strict": true,
    // search.test.ts imports "./search.ts" with an explicit extension, since
    // it also runs directly via Node's native TS stripping (`node --test`),
    // which requires one for relative ESM specifiers. Valid alongside
    // noEmit + moduleResolution "bundler", both already set upstream.
    "allowImportingTsExtensions": true,
    // search-preview.tsx imports the generated search-index.json directly.
    "resolveJsonModule": true
  },
  "exclude": [".docusaurus", "build"]
}
